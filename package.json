{
  "name": "path-backend",
  "version": "1.0.0",
  "packageManager": "pnpm@11.17.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest --pool=forks run",
    "test:debug": "node --inspect-brk ./node_modules/.bin/vitest --pool=forks run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.db.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:reset:bare": "TS_NODE_PROJECT=tsconfig.db.json ts-node db/reset.ts",
    "db:migrate": "TS_NODE_PROJECT=tsconfig.db.json ts-node db/migrate.ts",
    "db:migrate:new": "supabase migration new",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:seed": "TS_NODE_PROJECT=tsconfig.db.json ts-node db/seed/index.ts",
    "db:types": "supabase gen types typescript --local > db/types.generated.ts",
    "db:test": "supabase test db",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "http-status-codes": "^2.3.0",
    "js-yaml": "^4.2.0",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supabase": "^2.111.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.9"
  }
}
